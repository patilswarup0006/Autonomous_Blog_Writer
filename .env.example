# LLM Provider Key (Groq API)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter API Key (Fallback Provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Web Search Tool Key (Tavily Search API)
TAVILY_API_KEY=your_tavily_api_key_here

# Image Generation Key (Optional - Google Gemini API)
# Fallback to Pollinations AI is automatic if Gemini is not set or quota is exceeded
GOOGLE_API_KEY=your_google_gemini_api_key_here
